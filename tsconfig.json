{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/components/ui-bak"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strictNullChecks": true,
    "allowJs": true,
    "paths": {
      "#*": ["./src/*"]
    }
  }
}
