---
import type { PostListItemType } from "#lib/contents";
import { ButtonAnchor } from "#components/ui/button";
import { Fa7SolidHashtag } from "#icons/fa7/solid/hashtag";
import { LayoutGridIcon } from "#icons/runeicons/normal/layout-grid";
import { CalendarIcon } from "#icons/runeicons/normal/calendar";

interface Props {
  item: PostListItemType;
}

const { item } = Astro.props;
const { id, category, draft, description, published, tags, title } = item;
const currentPath = Astro.url.pathname;
---

<li>
  <div
    class="group relative flex items-center justify-between p-4 md:rounded-xl bg-background overflow-hidden transition-all duration-100 border-b md:border border-border md:shadow-sm md:hover:ring-2 md:hover:ring-primary"
  >
    <div>
      <h2 class="text-2xl font-semibold">
        <a
          class="hover:text-primary md:hover:text-foreground md:after:absolute md:after:inset-0 md:after:z-0"
          href={`/post/${id}`}>{title}</a
        >
      </h2>
      {description !== undefined && description !== "" && <p class="text-sm mt-1">{description}</p>}
      <div class="flex flex-wrap items-center gap-4 mt-3">
        <div class="flex items-center gap-1">
          <div class="rounded-md size-6 bg-primary text-primary-foreground grid place-content-center">
            <CalendarIcon class="size-4" />
          </div>
          <p class="text-sm px-2">{published.toISOString().slice(0, 10)}</p>
        </div>
        <div class="flex items-center gap-1">
          <div class="rounded-md size-6 bg-primary text-primary-foreground grid place-content-center">
            <LayoutGridIcon class="size-4" />
          </div>
          <ButtonAnchor
            href={`/?category=${encodeURIComponent(category)}`}
            class="relative z-10 h-7 px-2"
            variant="ghostPrimary"
            size="sm"
          >
            {category}
          </ButtonAnchor>
        </div>
        {
          tags.length > 0 && (
            <div class="flex items-center gap-1">
              <div class="rounded-md size-6 bg-primary text-primary-foreground grid place-content-center">
                <Fa7SolidHashtag class="size-4" />
              </div>
              <ul class="flex">
                {tags.map((tag) => (
                  <li>
                    <ButtonAnchor
                      href={`/?tags=${encodeURIComponent(tag)}`}
                      class="relative z-10 h-7 px-2"
                      variant="ghostPrimary"
                      size="sm"
                    >
                      #{tag}
                    </ButtonAnchor>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
    <div class="relative pr-4 hidden invisible md:block md:visible">
      <div
        class="absolute w-3 h-1 top-1/2 -translate-y-1/2 translate-x-3 -left-3 rotate-y-90 bg-primary transition-all duration-300 ease-out-quint group-hover:translate-x-0 group-hover:rotate-y-0"
      >
      </div>
      <div
        class="w-0 h-0 border-t-10 border-t-transparent! border-b-10 border-b-transparent! border-l-16 border-primary scale-80 transition-all duration-300 ease-out-quint group-hover:scale-100"
      >
      </div>
    </div>
  </div>
</li>
