---
import {
  Pagination,
  PaginationContent,
  PaginationEllipsis,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious,
} from "#components/ui/pagination";

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const prevURL = new URL(Astro.url);
prevURL.searchParams.set("page", Math.max(1, currentPage - 1).toString());
const nextURL = new URL(Astro.url);
nextURL.searchParams.set("page", Math.min(totalPages, currentPage + 1).toString());

const startPage = Math.max(1, currentPage - 2);
const endPage = Math.min(totalPages, currentPage + 2) + 1;
---

<div class="rounded-xl bg-background items-center p-2 border border-border shadow-sm w-fit mx-auto">
  <Pagination>
    <PaginationContent>
      <PaginationItem>
        <PaginationPrevious href={prevURL.toString()} disabled={currentPage === 1} />
      </PaginationItem>
      {
        Array.from({ length: endPage - startPage }, (_, i) => i + startPage).map((page) => {
          const pageURL = new URL(Astro.url);
          pageURL.searchParams.set("page", page.toString());

          return (
            <PaginationItem>
              <PaginationLink href={pageURL.toString()} isActive={page === currentPage}>
                {page}
              </PaginationLink>
            </PaginationItem>
          );
        })
      }
      <PaginationItem>
        <PaginationNext href={nextURL.toString()} disabled={currentPage === totalPages} />
      </PaginationItem>
    </PaginationContent>
  </Pagination>
</div>
