---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<aside>
  <ul>
    {
      headings
        .filter((heading) => heading.depth < 4)
        .map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>
              <span>{heading.text}</span>
            </a>
          </li>
        ))
    }
  </ul>
</aside>
