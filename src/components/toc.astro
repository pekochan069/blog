---
import type { MarkdownHeading } from "astro";
import { cn } from "cn";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

{
	headings.length > 0 && (
		<div class="rounded-xl bg-background flex flex-col py-2 px-3 border border-border shadow-sm">
			<ul>
				{headings
					.filter((heading) => heading.depth < 5)
					.map((heading) => (
						<li>
							<a
								href={`#${heading.slug}`}
								style={`margin-left: ${heading.depth - 2}rem`}
								class="toc-link inline-flex gap-2 text-sm text-muted-foreground hover:text-foreground data-[current=true]:text-primary-foreground"
								data-slug={heading.slug}
							>
								<span>{heading.text.slice(0, -1)}</span>
							</a>
						</li>
					))}
			</ul>
		</div>
	)
}

<script>
	const { hash } = new URL(window.location.href);

	for (const tocLink of document.querySelectorAll<HTMLAnchorElement>(".toc-link")) {
		if (hash === tocLink.getAttribute("href")) {
			tocLink.classList.remove("text-muted-foreground");
			tocLink.classList.add("text-foreground", "font-semibold", "underline");
		}

		tocLink.addEventListener("click", (event) => {
			event.preventDefault();
			const href = tocLink.getAttribute("href");
			const target = href === null ? null : document.querySelector(href);
			if (target) {
				target.scrollIntoView({ behavior: "smooth" });
				window.history.pushState(null, "", tocLink.getAttribute("href"));
				for (const l of document.querySelectorAll<HTMLAnchorElement>(".toc-link")) {
					l.classList.remove("text-foreground", "font-semibold", "underline");
					l.classList.add("text-muted-foreground");
				}
				tocLink.classList.remove("text-muted-foreground");
				tocLink.classList.add("text-foreground", "font-semibold", "underline");
			}
		});
	}
</script>
