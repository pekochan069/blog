---
import "#styles/app.css";
import Header from "#components/header/header.astro";
import Sidebar from "#components/sidebar/sidebar.astro";
import { ScrollToTop } from "#components/scroll-to-top";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      document.documentElement.dataset["theme"] = isDark ? "catppuccin-macchiato" : "catppuccin-latte";

      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const changedIsDark = document.documentElement.classList.contains("dark");
          localStorage.setItem("theme", changedIsDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
          attributeFilter: ["class"],
          attributes: true,
        });
      }

      document.addEventListener("astro:before-swap", (event) => {
        const changedIsDark = getThemePreference() === "dark";
        event.newDocument.documentElement.classList.toggle("dark", changedIsDark);
        event.newDocument.documentElement.dataset["theme"] = changedIsDark
          ? "catppuccin-macchiato"
          : "catppuccin-latte";
      });
    </script>
  </head>
  <body class="text-foreground bg-catppuccin-base min-h-svh relative">
    <Header />
    <div
      class="flex flex-col-reverse gap-2 md:max-w-6xl md:grid md:gap-6 md:grid-cols-[16rem_1fr] mt-26 mx-auto md:w-[95%]"
    >
      <Sidebar>
        <slot name="sidebar" />
      </Sidebar>
      <div class="min-h-[calc(100svh-5rem-6.6rem-3rem)] pb-12">
        <slot />
      </div>
    </div>
    <ScrollToTop client:load />
  </body>
</html>

<script is:inline>
  (() => {
    const siteHeaderContainer = document.querySelector("#site-header-container");

    function updateSiteHeader() {
      siteHeaderContainer.dataset.scrolled = String(window.scrollY > 40);
    }

    updateSiteHeader();
    window.addEventListener("scroll", updateSiteHeader, { passive: true });
  })();
</script>
