---
import BaseLayout from "#layouts/base-layout.astro";
import { getCurrentPagePosts } from "#lib/contents";

let posts = getCurrentPagePosts(1);

if (!posts) {
	posts = [];
}
---

<BaseLayout>
	<ul>
		{
			posts.map((post) => (
				<a href={`/post/${post.id}`}>
					<h2>{post.data.title}</h2>
					<p>{post.data.published.toLocaleDateString()}</p>
				</a>
			))
		}
	</ul>
</BaseLayout>
