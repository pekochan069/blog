---
import PostList from "#components/post-list/post-list.astro";
import BaseLayout from "#layouts/base-layout.astro";
import { getTotalPages, getCurrentPagePosts } from "#lib/contents";

export const prerender = false;

const category = Astro.url.searchParams.get("category");
const tags = Astro.url.searchParams.getAll("tags");
const page = Math.trunc(Number(Astro.url.searchParams.get("page") ?? "1"));

const totalPages = getTotalPages(category, tags);

if (page > totalPages) {
	const url = new URL(Astro.url);
	url.searchParams.delete("page");
	return Astro.redirect(url);
}

const posts = getCurrentPagePosts(page, category, tags);
---

<BaseLayout>
	<PostList
		totalPages={totalPages}
		currentPage={page}
		items={posts.map((post) => ({
			id: post.id,
			category: post.data.category,
			draft: post.data.draft,
			description: post.data.description,
			published: post.data.published,
			tags: post.data.tags,
			title: post.data.title,
		}))}
	/>
</BaseLayout>
