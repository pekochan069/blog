---
import { availableYears, getPostsInYear } from "#lib/contents";
import BaseLayout from "#layouts/base-layout.astro";

export const getStaticPaths = () =>
	availableYears.map((year) => ({
		params: {
			year: year.year.toString(),
		},
		props: year,
	}));

const { year, posts } = Astro.props;

const postsInYear = getPostsInYear(year);
---

<BaseLayout>
	<main class="rounded-xl h-full px-6 py-8 bg-background border border-border shadow-sm">
		<!-- <h2 class="text-4xl font-bold mb-4">{year}년</h2> -->
		<div class="relative isolate flex flex-col gap-12">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute left-24 top-4 bottom-0 -z-10 w-px -translate-x-1/2 bg-border"
			>
			</div>
			{
				postsInYear.entries().map(([month, posts]) => (
					<div>
						<div class="grid grid-cols-[4rem_3rem_1fr] items-center px-2">
							<span class="text-right text-2xl font-semibold">{month + 1}월</span>
							<div class="flex justify-center items-center">
								<div class="size-4 rounded-full bg-background border-3 border-primary ring-4 ring-background" />
							</div>
							<span class="text-sm text-muted-foreground">{posts.length}개의 글</span>
						</div>
						<ul class="flex flex-col mt-4">
							{posts.map((post) => (
								<li>
									<a
										href={`/post/${post.id}`}
										class="group rounded-lg grid grid-cols-[4rem_3rem_1fr] p-2 items-center transition-all hover:bg-accent/40 hover:text-accent-foreground hover:ring-1 hover:ring-foreground/5"
									>
										<span class="text-right font-light text-sm">{post.data.published.getDate()}일</span>
										<div class="flex justify-center items-center">
											<div class="size-1 rounded-full bg-primary ring-4 ring-background transition-all group-hover:ring-accent group-hover:h-5" />
										</div>
										<h2>{post.data.title}</h2>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</main>
</BaseLayout>
