---
import { EditorContainer } from "#components/admin/editor";
import AdminLayout from "#layouts/admin-layout.astro";
import { availableCategories, availableTags } from "#lib/contents";
import { parseRawMarkdown } from "#lib/markdown/parse-raw-markdown";
import { getPost } from "#lib/server/admin/get-post";
import { authCookieName, isLoggedIn } from "#lib/server/auth/is-logged-in";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

if (!isLoggedIn(Astro.cookies.get(authCookieName)?.value)) {
  return Astro.redirect("/admin/login", 303);
}

const { id } = Astro.params;

if (id === undefined) {
  return Astro.redirect("/admin", 303);
}

const rawPost = await getPost(id);
const post = parseRawMarkdown(rawPost.ok ? rawPost.data.body : undefined);
const sha = rawPost.ok ? rawPost.data.sha : undefined;
---

<AdminLayout>
  <EditorContainer
    id={id}
    availableCategories={availableCategories.map((c) => c.category)}
    availableTags={availableTags}
    category={post?.frontmatter.category ?? ""}
    description={post?.frontmatter.description ?? ""}
    draft={post?.frontmatter.draft ?? true}
    tags={post?.frontmatter.tags ?? []}
    title={post?.frontmatter.title ?? ""}
    body={post?.body ?? ""}
    published={post?.frontmatter.published}
    sha={sha}
    client:only="solid-js"
  />
</AdminLayout>
