---
import { CreateNewPost } from "#components/admin/create-new-post";
import AdminLayout from "#layouts/admin-layout.astro";
import { getPostList } from "#lib/server/admin/get-post-list";
import { authCookieName, isLoggedIn } from "#lib/server/auth/is-logged-in";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
if (!isLoggedIn(Astro.cookies.get(authCookieName)?.value)) {
  return Astro.redirect("/admin/login", 303);
}

const posts = await getPostList();
---

<AdminLayout>
  <div
    class="md:max-w-6xl mt-26 mx-auto md:w-[95%] rounded-xl bg-background flex flex-col p-2 border border-border shadow-sm"
  >
    <CreateNewPost client:load />
  </div>
  <div
    class="md:max-w-6xl mt-8 mx-auto md:w-[95%] rounded-xl bg-background flex flex-col p-2 border border-border shadow-sm"
  >
    {
      posts.ok ? (
        <div>
          <ul class="flex flex-col gap-2">
            {posts.data.map((post) => {
              return (
                <li class="group w-full">
                  <a
                    href={`/admin/${encodeURIComponent(post.name)}`}
                    class="w-full rounded-lg bg-background flex flex-col items-start justify-between p-2 transition-colors duration-75 group-hover:bg-sidebar-accent group-hover:text-sidebar-accent-foreground data-[current=true]:bg-primary data-[current=true]:text-primary-foreground"
                  >
                    <h2 class="font-semibold">{post.name}</h2>
                    {post.frontmatter && (
                      <div>
                        <p class="text-sm">{post.frontmatter.category}</p>
                        <p class="text-sm">{post.frontmatter.published.toISOString()}</p>
                      </div>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ) : (
        <div>{posts.error}</div>
      )
    }
  </div>
</AdminLayout>
