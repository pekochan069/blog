---
import { CreateNewPost } from "#components/admin/create-new-post";
import { EditorContainer } from "#components/admin/editor";
import AdminLayout from "#layouts/admin-layout.astro";
import { GetPostList } from "#lib/server/admin/get-post-list";

const posts = await GetPostList();
---

<AdminLayout>
  <div
    class="md:max-w-6xl mt-26 mx-auto md:w-[95%] rounded-xl bg-background flex flex-col p-2 border border-border shadow-sm"
  >
    <CreateNewPost client:load />
  </div>
  <div
    class="md:max-w-6xl mt-8 mx-auto md:w-[95%] rounded-xl bg-background flex flex-col p-2 border border-border shadow-sm"
  >
    {
      posts.ok ? (
        <div>
          <ul class="flex flex-col gap-2">
            {posts.data.map((post) => {
              const id = post.name.split(".").slice(0, -1).join(".");
              return (
                <li class="group w-full">
                  <a
                    href={`/admin/${encodeURIComponent(id)}`}
                    class="w-full rounded-lg bg-background flex items-center justify-between p-2 transition-colors duration-75 group-hover:bg-sidebar-accent group-hover:text-sidebar-accent-foreground data-[current=true]:bg-primary data-[current=true]:text-primary-foreground"
                  >
                    <span class="font-medium">{id}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ) : (
        <div>{posts.error}</div>
      )
    }
  </div>
</AdminLayout>
